# Loaded by `yarn start:backend`. Exported environment variables take precedence.
STORAGE_BUCKET=code4maus-local
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ENDPOINT_FRONTEND=http://localhost:8333
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=code4maus-local
AWS_SECRET_ACCESS_KEY=code4maus-local-secret

# These are local-only credentials. Compose sets its own matching environment.
# For a remote backend: unset STORAGE_ENDPOINT, STORAGE_ENDPOINT_FRONTEND,
# AWS_ACCESS_KEY_ID, and AWS_SECRET_ACCESS_KEY, set the remote STORAGE_BUCKET,
# and select AWS_PROFILE=code4maus-sso. The launcher enables shared AWS config.

# Optional (Compose sets BACKEND_HOST=0.0.0.0 inside the container).
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=3000
