# Local S3 reads go through the bucket path; start storage with Docker Compose.
PROXY_TARGET=http://localhost:8333/code4maus-local
AWS_REGION=eu-central-1

# Local API (either the Compose backend or `yarn start:backend` on the host).
API_PROXY_TARGET=http://localhost:3000

# Optional remote mode: set PROXY_TARGET=https://dev.maus.metahost.org
# and unset API_PROXY_TARGET to use the deployed API and data.

# Only used to fill in the legacy Netlify _redirects file at build time
S3_BUCKET_PREFIX=pmdm-projectbucket
