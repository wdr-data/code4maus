# Deployed stage that the dev server proxies /data and /api to
PROXY_TARGET=https://dev.maus.metahost.org
AWS_REGION=eu-central-1

# Optional: route /api to a local backend started with `yarn start:backend`
# API_PROXY_TARGET=http://localhost:3000/dev

# Only used to fill in the legacy Netlify _redirects file at build time
S3_BUCKET_PREFIX=pmdm-projectbucket
